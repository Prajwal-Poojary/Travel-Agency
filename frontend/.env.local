# Local Development Environment Configuration
# Advanced Travel Platform Frontend

# Backend API URL - Points to proxy
REACT_APP_BACKEND_URL=

# API Keys (You'll need to obtain these for full functionality)
REACT_APP_MAPBOX_TOKEN=your-mapbox-token-here

# WebSocket URL - Points to local backend
REACT_APP_WEBSOCKET_URL=

# React App Configuration
REACT_APP_ENV=development